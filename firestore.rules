rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'enfer.ro.98@gmail.com' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.rol == 'SuperAdmin'
      );
    }

    match /usuarios/{userEmail} {

      allow read: if isAuthenticated();

      allow write: if isSuperAdmin() || (
        isAuthenticated() && (

          (
            request.auth.token.email == userEmail &&
            (resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol']) ||
             (request.resource.data.rol != 'SuperAdmin' && request.resource.data.rol != 'Admin'))
          ) ||

          (
            request.resource.data.maestroId == request.auth.token.email &&
            request.resource.data.rol != 'SuperAdmin' &&
            request.resource.data.rol != 'Admin'
          ) ||

          (
            resource != null &&
            resource.data.maestroId == request.auth.token.email
          )
        )
      );
    }

    match /estancias/{maestroId} {

      allow read, write: if isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.token.email == maestroId ||
          get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.maestroId == maestroId
        )
      );

      match /eventos/{eventoId} {
        allow read, write: if isSuperAdmin() || (
          isAuthenticated() && (
            request.auth.token.email == maestroId ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data.maestroId == maestroId
          )
        );
      }
    }

    match /sistema/{documentId} {

      allow read: if isAuthenticated();

      allow write: if isSuperAdmin();
    }
  }
}
