rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Reglas para usuarios: permite que cualquier usuario autenticado lea y gestione su perfil
    match /usuarios/{userEmail} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && !request.resource.data.keys().hasAny(['password']);
    }

    // Reglas para estancias y eventos: permite lectura y escritura a usuarios autenticados
    match /estancias/{maestroId} {
      allow read, write: if isAuthenticated();

      match /eventos/{eventoId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Configuración global del sistema
    match /sistema/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
